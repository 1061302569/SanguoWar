{
  /* Base configuration. Do not edit this field. */
  "extends": "./temp/tsconfig.cocos.json",

  /* Add your custom configuration here. */
  "compilerOptions": {
    "strict": false
  },

  /* tools/ 是本地开发辅助脚本（用 node 运行，不参与游戏打包），
     其中带 .ts 扩展名的 import 与 Node 全局对象会让编辑器类型检查报错，
     因此从工程编译范围里排除。 */
  "exclude": [
    "node_modules",
    "library",
    "temp",
    "build",
    "tools"
  ]
}
